# API base path. With the dev proxy this stays "/api" (same-origin, no CORS needed).
# In production point it at the deployed API, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api

# Where `npm run dev` forwards /api requests
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Display name used in the shell, login page and document title
VITE_APP_NAME=App Template

# true = run against the in-memory mock API in src/mocks (no backend needed)
VITE_ENABLE_MOCK=false
